{
  "name": "scrubline-panel",
  "displayName": "Scrubline Review Panel",
  "description": "Disk checkpoints and a source timeline",
  "version": "0.11.2",
  "publisher": "scrubline",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:scrubline.historyView",
    "onCommand:scrubline.openPanel",
    "onStartupFinished",
    "onCommand:scrubline.startMcp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "scrubline.openPanel",
        "title": "Scrubline: Open Timeline Panel",
        "category": "Scrubline"
      },
      {
        "command": "scrubline.openChatbot",
        "title": "Scrubline: Open UI Advisor Chatbot",
        "category": "Scrubline"
      },
      {
        "command": "scrubline.startMcp",
        "title": "Scrubline: Start Local MCP"
      },
      {
        "command": "scrubline.pickAdvisorModel",
        "title": "Scrubline: Pick Advisor Model (agy CLI)"
      },
      {
        "command": "scrubline.compactHistory",
        "title": "Scrubline: Compact unused history data"
      },
      {
        "command": "scrubline.deleteHistory",
        "title": "Scrubline: Delete workspace history"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scrubline-container",
          "title": "Scrubline",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "scrubline-container": [
        {
          "type": "webview",
          "id": "scrubline.historyView",
          "name": "Scrubline Timeline"
        }
      ]
    },
    "configuration": {
      "title": "Scrubline",
      "properties": {
        "scrubline.maxFiles": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "description": "Tracked file limit.",
          "scope": "resource"
        },
        "scrubline.maxFileMB": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Maximum tracked file size.",
          "scope": "resource"
        },
        "scrubline.maxTotalMB": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Maximum captured bytes.",
          "scope": "resource"
        },
        "scrubline.quotaMB": {
          "type": "number",
          "default": 512,
          "minimum": 1,
          "description": "History storage quota.",
          "scope": "resource"
        },
        "scrubline.hookLog": {
          "type": "string",
          "default": "",
          "description": "Optional sanitised hook log outside the workspace.",
          "scope": "resource"
        },
        "scrubline.previewCommand": {
          "type": "string",
          "default": "",
          "description": "Trusted local preview command. Use {port} for the port; runs in isolated historical snapshots when scrubbing.",
          "scope": "resource"
        },
        "scrubline.previewPort": {
          "type": "number",
          "default": 4100,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Local preview port.",
          "scope": "resource"
        },
        "scrubline.previewTimeoutSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 60,
          "description": "Preview startup timeout.",
          "scope": "resource"
        },
        "scrubline.chromiumPath": {
          "type": "string",
          "default": "",
          "description": "Optional installed Chromium executable for checkpoint screenshots. No browser download at runtime.",
          "scope": "resource"
        },
        "scrubline.postApplyCommand": {
          "type": "string",
          "default": "",
          "description": "Trusted build/test command for isolated selective-apply candidate. Required before selective apply.",
          "scope": "resource"
        },
        "scrubline.ignoreAdditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional gitignore-style paths to keep out of checkpoints.",
          "scope": "resource"
        },
        "scrubline.previewWidth": {
          "type": "number",
          "default": 960,
          "minimum": 240,
          "maximum": 3840,
          "description": "Preview viewport width in CSS pixels.",
          "scope": "resource"
        },
        "scrubline.previewHeight": {
          "type": "number",
          "default": 600,
          "minimum": 240,
          "maximum": 3840,
          "description": "Preview viewport height in CSS pixels.",
          "scope": "resource"
        },
        "scrubline.previewRoute": {
          "type": "string",
          "default": "/",
          "description": "Local preview path, including optional query. No external URL or fragment.",
          "scope": "resource"
        },
        "scrubline.previewReadySelector": {
          "type": "string",
          "default": "",
          "description": "Optional unique selector that must become visible before capture.",
          "scope": "resource"
        },
        "scrubline.multiSelectLimit": {
          "type": "number",
          "default": 20,
          "minimum": 2,
          "maximum": 50,
          "description": "Maximum checkpoints selectable for one multi-checkpoint review."
        },
        "scrubline.backendCapture": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Record metadata (method, redacted URL, status, timing) of page network requests during renders. Query values, headers, cookies and bodies are never stored."
        },
        "scrubline.backendCaptureFilter": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional glob limiting which request URLs are recorded (for example **/api/**). Empty records all requests the page makes during the render."
        },
        "scrubline.backendMaxRequests": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "maximum": 1000,
          "scope": "resource",
          "description": "Maximum requests recorded per render."
        },
        "scrubline.backendDiagrams": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Build static backend route map and module import graph from checkpoint source."
        },
        "scrubline.advisorBackend": {
          "type": "string",
          "enum": [
            "auto",
            "ide",
            "agy"
          ],
          "default": "auto",
          "description": "UI Advisor backend. auto: IDE language models if the IDE exposes any to extensions (Antigravity currently exposes none), then the agy CLI; ide: IDE models only; agy: agy CLI only. When no backend works, the real error is shown in the chat; there are no offline or hardcoded answers.",
          "scope": "resource"
        },
        "scrubline.agyPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Antigravity CLI executable. Empty resolves \"agy\" via PATH.",
          "scope": "machine"
        },
        "scrubline.advisorTimeoutMs": {
          "type": "number",
          "default": 90000,
          "minimum": 5000,
          "description": "Milliseconds to wait for the Antigravity CLI answer before falling back.",
          "scope": "resource"
        },
        "scrubline.advisorModel": {
          "type": "string",
          "default": "",
          "description": "Optional model override passed to the agy CLI as --model for UI Advisor queries.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.js",
    "package": "vsce package",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:ui": "playwright test",
    "check:nomock": "node scripts/check-nomock.js",
    "test:host": "node test/host/run.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/parser": "^8.0.7",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "eslint": "9.39.5",
    "globals": "15.15.0",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "3.9.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  },
  "repository": {
    "url": "https://github.com/xGTAT/Scrubline.git",
    "type": "git"
  },
  "license": "UNLICENSED",
  "private": "true",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@phosphor-icons/react": "2.1.10",
    "css-select": "^6.0.0",
    "ignore": "5.3.2",
    "parse5": "7.3.0",
    "parse5-htmlparser2-tree-adapter": "^7.1.0",
    "playwright-core": "1.63.0",
    "postcss": "8.5.29",
    "typescript": "^5.3.3",
    "zod": "4.6.5"
  }
}
